{
  "compilerOptions": {
    "outDir": "./dist",

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    
    "sourceMap": true,
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "prisma.config.ts", "generated/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
