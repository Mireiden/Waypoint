generator client {
  provider        = "prisma-client"
  previewFeatures = ["typedSql"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum DestinationType {
  point
  route
}

enum ReportStatus {
  pending
  approved
  declined
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(255)
  role         Role     @default(user)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  destinations Destination[]
  reviews      Review[]
  reports      Report[]

  @@map("users")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(200)
  icon        String? @db.VarChar(100)

  destinations Destination[]

  @@map("categories")
}

model Destination {
  id          Int                     @id @default(autoincrement())
  title       String                  @db.VarChar(255)
  description String?
  type        DestinationType
  geometry    Unsupported("geometry")
  city        String?                 @db.VarChar(100)
  country     String?                 @db.VarChar(100)
  images      String[]
  userId      Int                     @map("user_id")
  categoryId  Int                     @map("category_id")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")
  category Category     @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_category")
  reviews  Review[]
  reports  Report[]
  asPoint  RoutePoint[] @relation("point")
  asRoute  RoutePoint[] @relation("route")

  @@index([city, country], map: "idx_destinations_city_country")
  @@index([geometry], map: "idx_destinations_geometry", type: Gist)
  @@index([userId], map: "idx_destinations_user")
  @@map("destinations")
}

model RoutePoint {
  routeId  Int @map("route_id")
  pointId  Int @map("point_id")
  position Int

  route Destination @relation("route", fields: [routeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_route_id")
  point Destination @relation("point", fields: [pointId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_point_id")

  @@id([routeId, pointId])
  @@unique([routeId, position])
  @@map("route_points")
}

model Review {
  id            Int      @id @default(autoincrement())
  rating        Int
  comment       String?
  images        String[]
  userId        Int      @map("user_id")
  destinationId Int      @map("destination_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_id")
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_destination_id")
  reports     Report[]

  @@index([destinationId], map: "idx_reviews_destination")
  @@map("reviews")
}

model Report {
  id            Int          @id @default(autoincrement())
  reason        String?      @db.VarChar(255)
  note          String?
  status        ReportStatus @default(pending)
  userId        Int          @map("user_id")
  destinationId Int?         @map("destination_id")
  reviewId      Int?         @map("review_id")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_id")
  destination Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_destination_id")
  review      Review?      @relation(fields: [reviewId], references: [id], onUpdate: NoAction, map: "fk_review_id")

  @@map("reports")
}
